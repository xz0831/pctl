# pctl settings. Copy into your shell profile or source it: . ./pctl.env.example
# No secrets belong here: agents use their own existing CLI login.

# Required unless config.toml names a [server] start_env: lets pctl start its own tmux server.
export PCTL_STANDALONE=1

# Optional. Defaults shown.
# export PCTL_STATE="$HOME/.local/state/pctl"   # one tmux server and mailbox for every project
# export PCTL_TMUX=tmux                         # path to tmux 3.8 or newer if not on PATH
